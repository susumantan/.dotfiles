# macOS
macos-option-as-alt = true

# typography
font-family = "Iosevka Term"
font-size = 15
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

# aesthetics
macos-titlebar-style = hidden
background = #010409
background-blur = 16
background-opacity = 0.85
foreground = #e6edf3
selection-background = #264f78
selection-foreground = #e6edf3
cursor-color = #e6edf3
cursor-text = #010409
palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4
palette = 8=#6e7681
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff

