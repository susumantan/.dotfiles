# macOS
macos-option-as-alt = true

# typography
font-family = Iosevka
font-size = 15
# font-thicken = true
# font-thicken-strength = 1
# adjust-cell-height = 1

# aesthetics
background-opacity = 0.85
background-blur = 16
background = #000000
macos-titlebar-style = hidden

# Quick Terminal
# quick-terminal-position = left
# quick-terminal-size = 75%
# quick-terminal-animation-duration = 0
# quick-terminal-autohide = true
# keybind = global:super+ctrl+shift+alt+g=toggle_quick_terminal

# Command
# We need to use full path to tmux because ghostty doesn't inherit the PATH environment variable from the shell
command = /opt/homebrew/bin/tmux new-session -A -t ghostty
