set nocompatible

set nobackup
set noswapfile

syntax on

set modelines=0 

set encoding=utf-8

set formatoptions=tcqrn1
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set noshiftround

set ttyfast

set laststatus=2

set showmode
set showcmd

set listchars=tab:▸\ ,eol:¬

" Color scheme (terminal)
set t_Co=256
set background=dark