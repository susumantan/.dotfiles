#!/usr/bin/env bash

# gdeploy - Used in KOPNUS to deploy to dev server.

STARTING_BRANCH=$(git branch --show-current 2>/dev/null)

_err()  { gum style --foreground 196 "✗ $*"; }
_info() { gum style --foreground 39  "→ $*"; }
_warn() { gum style --foreground 214 "⚠ $*"; }
_dim()  { gum style --foreground 244 "$*"; }
_ok()   { gum style --foreground 82  "✓ $*"; }

cleanup_and_abort() {
    echo ""
    _warn "Aborting deployment. Returning to $STARTING_BRANCH."

    if git merge --abort >/dev/null 2>&1; then
        _dim "  Merge aborted successfully."
    fi

    if [ -n "$STARTING_BRANCH" ]; then
        git checkout "$STARTING_BRANCH" >/dev/null 2>&1
        _dim "  Returned to $STARTING_BRANCH."
    fi
    exit 1
}

if [ ! -d ".git" ]; then
    _err "Not at the root of a git repository."
    exit 1
fi

# Check for uncommitted changes.
if ! git diff-index --quiet HEAD --; then
    _err "Your working directory has uncommitted changes."
    _warn "Stash or commit your work before running gdeploy."
    exit 1
fi

# Branch verifying.
if ! git rev-parse --verify origin/dev >/dev/null 2>&1; then
    _err "'dev' branch does not exist in remote cache. Run 'git fetch' first."
    exit 1
fi

CURRENT_BRANCH="$STARTING_BRANCH"
# TODO: This is a workaround for a weird issue
# where the running branch is 'development'
REMOTE_REPO=$(git remote -v | awk '/origin/{print $2}' | head -n 1 | sed 's|.*[:/]\(.*\)\.git|\1|')
if [[ "$REMOTE_REPO" == "api-cbs-web" ]]; then
    TARGET_BRANCH="development"
else
    TARGET_BRANCH="dev"
fi

# Confirmation prompt.
echo ""
gum style \
    --border double --border-foreground 212 \
    --padding "1 3" --margin "0 1" \
    --bold \
    "  DEPLOY  $CURRENT_BRANCH  →  $TARGET_BRANCH  "
echo ""
_dim "$(git remote -v)"
echo ""

gum confirm "Deploy '$CURRENT_BRANCH' → '$TARGET_BRANCH'?" || {
    echo ""
    _warn "Deployment cancelled."
    exit 1
}

echo ""
_info "Starting deployment: $CURRENT_BRANCH → $TARGET_BRANCH"
echo ""

# Step 1: Push work to origin first.
_info "Step 1/4  Pushing $CURRENT_BRANCH to origin..."
git push origin "$CURRENT_BRANCH"
echo ""

# Step 2: Switch to dev and sync.
_info "Step 2/4  Syncing $TARGET_BRANCH with origin..."
git checkout "$TARGET_BRANCH" >/dev/null 2>&1

if ! gum spin --spinner dot --title "Fetching and resetting $TARGET_BRANCH from origin..." -- \
    bash -c "git fetch origin $TARGET_BRANCH >/dev/null 2>&1 && git reset --hard origin/$TARGET_BRANCH >/dev/null 2>&1"; then
    _err "Failed to sync local history with origin/$TARGET_BRANCH."
    cleanup_and_abort
fi
_ok "Synced $TARGET_BRANCH with origin."
echo ""

# Step 3: Merge.
_info "Step 3/4  Merging $CURRENT_BRANCH into $TARGET_BRANCH..."
if ! git merge --no-edit "$CURRENT_BRANCH"; then
    echo ""
    _err "Merge conflicts detected."
    echo ""
    gum style \
        --border normal --border-foreground 196 \
        --padding "1 2" --margin "0 1" \
        "RECOVERY — resolve conflicts manually, then re-deploy:" \
        "" \
        "  git checkout dev" \
        "  git merge $CURRENT_BRANCH" \
        "  [Resolve conflicts in your editor]" \
        "  git add . && git commit" \
        "  git push origin dev && git push dev dev"
    cleanup_and_abort
fi
echo ""

# Step 4: Dual push.
_info "Step 4/4  Pushing $TARGET_BRANCH to remotes..."

_dim "  Pushing to origin/$TARGET_BRANCH..."
if ! git push origin "$TARGET_BRANCH"; then
    _err "Failed to push $TARGET_BRANCH to origin."
    cleanup_and_abort
fi

_dim "  Pushing to dev/$TARGET_BRANCH..."
if ! git push dev "$TARGET_BRANCH"; then
    _err "Failed to push $TARGET_BRANCH to dev."
    _warn "Manual fallback: git push dev $TARGET_BRANCH"
    cleanup_and_abort
fi

git checkout "$STARTING_BRANCH" >/dev/null 2>&1
echo ""
gum style --foreground 82 --bold "✓ Deployment complete. Returned to $STARTING_BRANCH."
echo ""
