#!/usr/bin/env bash

command -v sesh >/dev/null 2>&1 || { echo "sesh is not installed"; exit 1; }

command -v fzf >/dev/null 2>&1 || { echo "fzf is not installed"; exit 1; }

command -v fd >/dev/null 2>&1 || { echo "fd is not installed"; exit 1; }

cmd='fd --type d --max-depth 1 --min-depth 1 .'

selected_dir=$(
   fzf-tmux -p 80%,70% \
        --height=50% \
        --no-sort --ansi \
        --header 'CTRL-X (zoxide) / CTRL-R (reload)' \
        --bind "start:reload:$cmd '$HOME/Herd' '$HOME/work' '$HOME/sandbox'" \
        --bind 'ctrl-x:reload(sesh list -z)' \
        --bind "ctrl-r:reload($cmd '$HOME/Herd' '$HOME/work' '$HOME/sandbox')"
)

sesh connect "$selected_dir" || exit 0
